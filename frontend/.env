# ---------- Build Stage ----------
FROM node:20-alpine AS builder

WORKDIR /app

# build-argで渡す環境変数（Supabaseなど）
ARG SUPABASE_URL
ARG SUPABASE_KEY

# package.jsonをコピー
COPY node/package*.json ./

# 依存関係インストール（dev含む）
RUN npm ci

# ソースコードコピー
COPY node/ .

# 環境変数をビルド時に設定
ENV SUPABASE_URL=$SUPABASE_URL
ENV SUPABASE_KEY=$SUPABASE_KEY

# TypeScriptビルド
RUN npm run build

# ---------- Production Stage ----------
FROM node:20-alpine

WORKDIR /app

# build-argを本番イメージにも渡せるように
ARG SUPABASE_URL
ARG SUPABASE_KEY

# 本番用依存のみ
COPY node/package*.json ./
RUN npm ci --omit=dev

# ビルド成果物のみコピー
COPY --from=builder /app/dist ./dist

# 環境変数セット
ENV NODE_ENV=production
ENV PORT=8080
ENV SUPABASE_URL=$SUPABASE_URL
ENV SUPABASE_KEY=$SUPABASE_KEY

EXPOSE 8080

CMD ["node", "dist/index.js"]=https://backend-node-375431867308.asia-northeast1.run.app/api

