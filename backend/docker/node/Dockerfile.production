# ---------- Build Stage ----------
FROM node:20-alpine AS builder

WORKDIR /app

# build-argで渡す環境変数
ARG SUPABASE_URL
ARG SUPABASE_ANON_KEY
ARG NODE_ENV
ARG FRONTEND_URL
ARG PORT

# package.jsonをコピー
COPY node/package*.json ./

# 依存関係インストール（dev含む）
RUN npm ci

# ソースコードコピー
COPY node/ .

# 環境変数をビルド時に設定
ENV SUPABASE_URL=$SUPABASE_URL
ENV SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
ENV NODE_ENV=$NODE_ENV
ENV FRONTEND_URL=$FRONTEND_URL
ENV PORT=$PORT

# TypeScriptビルド
RUN npm run build

# ---------- Production Stage ----------
FROM node:20-alpine

WORKDIR /app

# build-arg
ARG SUPABASE_URL
ARG SUPABASE_ANON_KEY
ARG NODE_ENV
ARG FRONTEND_URL
ARG PORT

# 本番用依存のみ
COPY node/package*.json ./
RUN npm ci --omit=dev

# ビルド成果物のみコピー
COPY --from=builder /app/dist ./dist

# 環境変数セット
ENV NODE_ENV=$NODE_ENV
ENV PORT=$PORT
ENV SUPABASE_URL=$SUPABASE_URL
ENV SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
ENV FRONTEND_URL=$FRONTEND_URL

EXPOSE 8080

CMD ["node", "dist/index.js"]